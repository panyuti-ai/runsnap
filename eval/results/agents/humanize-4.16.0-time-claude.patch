+def _naturaldelta_under_a_day(delta: dt.timedelta, min_unit: Unit) -> str:
+    """Describe a timedelta shorter than one day for `naturaldelta`."""
+    seconds = delta.seconds
+    microseconds = delta.microseconds
+
+    if seconds == 0:
+        if min_unit == Unit.MICROSECONDS and microseconds < 1000:
+            return (
+                _ngettext("%d microsecond", "%d microseconds", microseconds)
+                % microseconds
