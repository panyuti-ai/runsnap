+def _format_unit(unit: Unit, value: float, min_unit: Unit, format: str) -> str:
+    """Format one `precisedelta` component, such as "3 hours" or "1.50 minutes"."""
+    singular, plural = _UNIT_FORMATS[unit]
+    count = 2 if 1 < value < 2 else int(value)
+    text = _ngettext(singular, plural, count)
+    has_fraction = _has_fraction(value)
+
+    if unit == min_unit and has_fraction:
+        return text.replace("%d", format) % value
+
+    if unit == Unit.YEARS:
+        if not has_fraction:
+            value = int(value)
+        return text.replace("%d", "%s") % intcomma(value)
+
