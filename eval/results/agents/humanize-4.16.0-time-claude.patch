+def _today_and_date(value: dt.date | dt.datetime) -> tuple[dt.date, dt.date]:
+    """Return today's date and `value` as a plain date.
+
+    For a tz-aware datetime, "today" is computed in that timezone so the
+    comparison uses the correct local date.
+
+    Raises:
+        AttributeError: If `value` isn't date-like.
+        OverflowError, ValueError: If the date arguments are out of range.
+    """
+    import datetime as dt
+
+    if isinstance(value, dt.datetime) and value.tzinfo is not None:
+        today = dt.datetime.now(value.tzinfo).date()
+    else:
+        today = dt.date.today()
+    return today, dt.date(value.year, value.month, value.day)
