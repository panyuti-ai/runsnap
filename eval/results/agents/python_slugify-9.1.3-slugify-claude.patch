+def _delimited_words(tokens: list[str], separator: str) -> Iterator[tuple[str, str]]:
+    """Yield (delimiter, word) for each nonempty token.
+
+    The delimiter repeats the separator once per dash before the word, so
+    delimiter runs (e.g. from post replacements) stay attached to the next word.
+    """
+    previous_index = 0
+    for index, word in enumerate(tokens):
+        if word:
+            yield separator * (index - previous_index), word
+            previous_index = index
