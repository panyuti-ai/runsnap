+def _date_and_today(value: Any) -> tuple[dt.date, dt.date]:
+    """Return the input date and today's date in the input's timezone."""
+    import datetime as dt
+
+    if isinstance(value, dt.datetime) and value.tzinfo is not None:
+        today = dt.datetime.now(value.tzinfo).date()
+    else:
+        today = dt.date.today()
+    return dt.date(value.year, value.month, value.day), today
